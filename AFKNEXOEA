local function part(parent,size,cf,col,mat,neon)
	local p=Instance.new("Part")
	p.Anchored=true p.CanCollide=false p.CanTouch=false p.CanQuery=false
	p.Size=size p.CFrame=cf p.Color=col
	p.Material=neon and Enum.Material.Neon or (mat or Enum.Material.Metal)
	p.TopSurface=Enum.SurfaceType.Smooth p.BottomSurface=Enum.SurfaceType.Smooth
	p.Parent=parent
	return p
end

local function clearScene()
	world:ClearAllChildren()
	ST.sc=nil ST.fx={} ST.wx={}
	vf.Visible=false
end

local function buildEnv(sc)
	vf.BackgroundColor3=sc.sky
	vf.Ambient=sc.sky:Lerp(C(255,255,255),0.4)
	vf.LightColor=C(255,255,255)
	vf.LightDirection=Vector3.new(-0.5,-1,-0.4)
	part(world,Vector3.new(600,1,600),CFrame.new(0,-0.5,0),sc.gr,Enum.Material.Concrete)
	local r1=part(world,Vector3.new(0.3,74,74),CFrame.new(0,0.05,0)*CFrame.Angles(0,0,math.rad(90)),sc.neon,nil,true)
	r1.Shape=Enum.PartType.Cylinder
	local r2=part(world,Vector3.new(0.3,70,70),CFrame.new(0,0.12,0)*CFrame.Angles(0,0,math.rad(90)),sc.gr,Enum.Material.Metal)
	r2.Shape=Enum.PartType.Cylinder
	local e=sc.env
	if e.pil then
		local n,hmin,hmax,col,tilt,win=table.unpack(e.pil)
		for i=1,n do
			local a=math.random()*math.pi*2
