		end
	end
	if e.planet then
		local pl=part(world,Vector3.new(150,150,150),CFrame.new(-120,95,-270),e.planet,Enum.Material.SmoothPlastic)
		pl.Shape=Enum.PartType.Ball
	end
	if e.cracks then
		for i=1,32 do
			local a=math.random()*math.pi*2
			local r=22+math.random()*80
			part(world,Vector3.new(0.6,0.1,10+math.random()*20),
				CFrame.new(math.cos(a)*r,0.15,math.sin(a)*r)*CFrame.Angles(0,math.random()*6,0),e.cracks,nil,true)
		end
	end
	if e.sun then
		for _,sx in ipairs({-1,1}) do
			local s=part(world,Vector3.new(90,90,90),CFrame.new(sx*60,75,-320*sx),e.sun,nil,true)
			s.Shape=Enum.PartType.Ball
		end
	end
	local wk,wc=sc.wx[1],sc.wx[2]
	for i=1,45 do
		local sz=(wk=="rain") and Vector3.new(0.15,4,0.15) or Vector3.new(0.5,0.5,0.5)
		local p=part(world,sz,CFrame.new(math.random(-90,90),math.random(0,70),math.random(-90,90)),wc,nil,true)
		local v
		if wk=="up" then v=Vector3.new(math.random(-2,2),math.random(6,14),math.random(-2,2))
		elseif wk=="down" then v=Vector3.new(math.random(-3,3),-math.random(4,9),math.random(-3,3))
		elseif wk=="rain" then v=Vector3.new(0,-80,0)
		else v=Vector3.new(math.random(-4,4),math.random(-1,1),math.random(-4,4)) end
		ST.wx[i]={p=p,v=v}
	end
end

local function newMech(col,acc,s,style)
	local m={s=s,acc=acc,style=style}
	local dk=col:Lerp(C(0,0,0),0.45)
	local function P(n,sz,c,neon) m[n]=part(world,sz*s,CFrame.new(),c,nil,neon) end
	P("torso",Vector3.new(4,4.2,2.4),col)
	P("chest",Vector3.new(3,1.6,0.4),dk)
	P("core",Vector3.new(0.9,0.9,0.3),acc,true)
	P("hip",Vector3.new(3,1,2),dk)
	P("head",Vector3.new(1.8,1.8,1.8),col)
	P("visor",Vector3.new(1.5,0.45,0.2),acc,true)
	P("crest",Vector3.new(0.4,1,1.8),acc)
	P("pack",Vector3.new(2.8,3,1),dk)
	P("glow",Vector3.new(1.6,0.5,0.3),acc,true)
	for _,k in ipairs({"L","R"}) do
		P("sp"..k,Vector3.new(1.9,1.9,2.2),col)
		P("up"..k,Vector3.new(1,2.2,1),dk)
		P("fo"..k,Vector3.new(1.1,2.4,1.1),col)
		P("fist"..k,Vector3.new(1.2,1.2,1.2),dk)
		P("th"..k,Vector3.new(1.3,2.6,1.5),col)
		P("sh"..k,Vector3.new(1.2,2.8,1.3),dk)
		P("ft"..k,Vector3.new(1.4,0.5,2.4),dk)
	end
	P("blade",Vector3.new(0.35,0.9,5.8),acc,true)
	P("beam",Vector3.new(0.7,0.7,1),acc,true)
	P("proj",Vector3.new(1,1,1),acc,true)
	m.proj.Shape=Enum.PartType.Ball
	m.blade.Transparency=1 m.beam.Transparency=1 m.proj.Transparency=1
	return m
end

local function setPose(m,cf,P)
	local s=m.s
	local tc=cf*CFrame.Angles(P.lean,0,0)
	local function put(n,c) m[n].CFrame=c end
	put("torso",tc)
	put("chest",tc*CFrame.new(0,0.6*s,-1.3*s))
	put("core",tc*CFrame.new(0,0.6*s,-1.5*s))
	put("hip",cf*CFrame.new(0,-2.6*s,0))
	put("head",tc*CFrame.new(0,3.2*s,-0.1*s))
	put("visor",tc*CFrame.new(0,3.3*s,-1.0*s))
	put("crest",tc*CFrame.new(0,4.3*s,0.2*s))
	put("pack",tc*CFrame.new(0,0.4*s,1.6*s))
	put("glow",tc*CFrame.new(0,-0.9*s,2.15*s))
	for _,sd in ipairs({-1,1}) do
		local k=(sd<0) and "L" or "R"
		local sh=tc*CFrame.new(sd*2.9*s,1.6*s,0)
		put("sp"..k,sh*CFrame.new(0,0.3*s,0))
		local o1=sh*CFrame.Angles(P["a"..k],0,sd*0.12)
		put("up"..k,o1*CFrame.new(0,-1.1*s,0))
		local o2=o1*CFrame.new(0,-2.2*s,0)*CFrame.Angles(P["b"..k],0,0)
		put("fo"..k,o2*CFrame.new(0,-1.2*s,0))
		put("fist"..k,o2*CFrame.new(0,-2.8*s,0))
		if sd==1 then m.o2R=o2 end
		local hp=cf*CFrame.new(sd*1.0*s,-3.1*s,0)
		local h1=hp*CFrame.Angles(P["l"..k],0,sd*0.07)
		put("th"..k,h1*CFrame.new(0,-1.3*s,0))
		local h2=h1*CFrame.new(0,-2.6*s,0)*CFrame.Angles(-P["k"..k],0,0)
		put("sh"..k,h2*CFrame.new(0,-1.4*s,0))
		put("ft"..k,h2*CFrame.new(0,-2.95*s,-0.5*s))
	end
	m.blade.CFrame=m.o2R*CFrame.new(0,-2.8*s,-3.1*s)
end

local function curve(p)
	if p<0.45 then return -0.6*math.sin(p/0.45*math.pi/2)
	elseif p<0.6 then return -0.6+1.6*((p-0.45)/0.15)
	else return 1-((p-0.6)/0.4) end
end

local function basePose(tt)
	return {lean=0.12,aL=0.9+math.sin(tt*2)*0.05,bL=1.5,aR=0.9+math.sin(tt*2+1)*0.05,bR=1.5,
		lL=0.35,kL=0.3,lR=-0.25,kR=0.25}
end

local function attackPose(P,style,u,p,k)
	if style=="punch" then
		P["a"..k]=0.3+u*1.2 P["b"..k]=1.2*(1-math.max(u,0))
		P.lean=0.12+u*0.3 P.lL=0.35+u*0.25
	elseif style=="sword" then
		P.aR=2.5-u*1.2 P.bR=0.2 P.aL=0.6 P.bL=1.0 P.lean=0.1+u*0.35
	elseif style=="laser" then
		if p>0.2 then P.aL=1.45 P.bL=0.15 P.aR=1.45 P.bR=0.15 end
		P.lean=-0.08
	elseif style=="kick" then
		P.lR=0.2+u*1.4 P.kR=1.3*(1-math.max(u,0))+0.1 P.lean=-u*0.3
		P.aL=-0.5 P.bL=0.6 P.aR=0.8 P.bR=1.0
	elseif style=="rocket" then
		if p>0.12 then P.aR=1.35 P.bR=0.2 end
		P.lean=-0.05
	end
end

local function doHit(atk,def,dirv)
	ST.lastHit=ST.T ST.lastDef=def
	local at=def.torso.Position+Vector3.new(0,0.8*def.s,0)-dirv*1.4*def.s
	for i=1,26 do
		local sp=part(world,Vector3.new(0.25,0.25,1.2)*(0.6+atk.s*0.4),CFrame.new(at),
			(i%3==0) and C(255,255,255) or atk.acc,nil,true)
		local v=(Vector3.new(math.random()-0.5,math.random()*0.8,math.random()-0.5).Unit)*(20+math.random()*35)*atk.s
		table.insert(ST.fx,{p=sp,v=v,t0=ST.T,dur=0.5,kind="spark"})
	end
	local b=part(world,Vector3.new(2,2,2)*def.s,CFrame.new(at),C(255,255,255),nil,true)
	b.Shape=Enum.PartType.Ball
	table.insert(ST.fx,{p=b,t0=ST.T,dur=0.4,kind="ball",s=def.s})
	HW.flash(0.55)
	ST.shake=1
end

local function stepScene(dt)
	local sc=ST.sc
	if not sc then return end
	ST.T+=dt
	local T=ST.T
	local A,B=ST.A,ST.B
	local D=6*(A.s+B.s)
	local n=math.floor(T/CL)
	local p=math.clamp(((T%CL)/CL)/0.72,0,1)
	local atk,def,dirv=A,B,Vector3.new(1,0,0)
	if n%2==1 then atk,def,dirv=B,A,Vector3.new(-1,0,0) end
	local PA,PB=basePose(T),basePose(T+1.3)
	local PAt,PDf=PA,PB
	if atk==B then PAt,PDf=PB,PA end
	local u=curve(p)
	local style=atk.style
	if style=="mix" then style=MIX[(n*3+1)%#MIX+1] end
	attackPose(PAt,style,u,p,(math.floor(n/2)%2==0) and "R" or "L")
	if p>=0.55 and ST.hitN~=n then ST.hitN=n doHit(atk,def,dirv) end
	local kk=T-ST.lastHit
	local r=(ST.lastDef==def) and math.max(0,1-kk/0.55) or 0
	if r>0 then
		PDf.lean=-0.55*r+0.12*(1-r)
		PDf.aL+=0.7*r PDf.aR+=0.5*r
	end
	local function off(m)
		if m==atk then return dirv*D*0.2*math.sin(p*math.pi) end
		if ST.lastDef==m then return dirv*3.5*m.s*math.sin(math.min(kk/0.6,1)*math.pi) end
		return Vector3.new(0,0,0)
	end
	local bob=math.sin(T*3)*0.12
	local pa=Vector3.new(-D/2,(ROOTY+bob)*A.s,0)+off(A)
	local pb=Vector3.new(D/2,(ROOTY-bob)*B.s,0)+off(B)
	setPose(A,CFrame.lookAt(pa,pa+Vector3.new(1,0,0)),PA)
	setPose(B,CFrame.lookAt(pb,pb+Vector3.new(-1,0,0)),PB)
	for _,m in ipairs({A,B}) do
		local sw=(m.style=="sword") or (m.style=="mix" and m==atk and style=="sword")
		m.blade.Transparency=sw and 0 or 1
		m.beam.Transparency=1 m.proj.Transparency=1
	end
	if style=="laser" and p>0.4 and p<0.78 then
		local a0=atk.fistR.Position
		local b0=def.torso.Position+Vector3.new(0,0.5*def.s,0)
		local len=(b0-a0).Magnitude
		atk.beam.Size=Vector3.new(0.7*atk.s,0.7*atk.s,len)
		atk.beam.CFrame=CFrame.lookAt(a0,b0)*CFrame.new(0,0,-len/2)
		atk.beam.Transparency=0.1+0.5*math.random()
	elseif style=="rocket" and p>0.2 and p<0.55 then
		local a0=atk.fistR.Position
		local b0=def.torso.Position
		local q=math.clamp((p-0.3)/0.25,0,1)
		local sz=(0.8+0.8*math.min((p-0.2)/0.1,1))*atk.s
		atk.proj.Size=Vector3.new(sz,sz,sz)
		atk.proj.Position=a0:Lerp(b0,q)
		atk.proj.Transparency=0
	end
	for i=#ST.fx,1,-1 do
		local f=ST.fx[i]
		local a=(T-f.t0)/f.dur
		if a>=1 then
			f.p:Destroy() table.remove(ST.fx,i)
		elseif f.kind=="spark" then
			f.v=f.v-Vector3.new(0,45*dt,0)
			local np=f.p.Position+f.v*dt
			f.p.CFrame=CFrame.lookAt(np,np+f.v)
			f.p.Transparency=a
		else
			local sz=(2+16*a)*f.s
			f.p.Size=Vector3.new(sz,sz,sz)
			f.p.Transparency=0.2+0.8*a
		end
	end
	for _,w in ipairs(ST.wx) do
		local q=w.p.Position+w.v*dt
		if q.Y>70 then q=Vector3.new(q.X,0,q.Z) elseif q.Y<0 then q=Vector3.new(q.X,70,q.Z) end
		if q.X>90 then q=Vector3.new(-90,q.Y,q.Z) elseif q.X<-90 then q=Vector3.new(90,q.Y,q.Z) end
		if q.Z>90 then q=Vector3.new(q.X,q.Y,-90) elseif q.Z<-90 then q=Vector3.new(q.X,q.Y,90) end
		w.p.Position=q
	end
	local k=math.max(A.s,B.s)
	local cA,cB=A.torso.Position,B.torso.Position
	local c=(cA+cB)/2
	local idx=math.floor(T/3.4)
	local shot=sc.shots[idx%#sc.shots+1]
	local lt=T-idx*3.4
	local pos,tgt,fov=c,c,60
	if shot==1 then
		local ang=T*0.22
		pos=c+Vector3.new(math.cos(ang)*30*k,8*k,math.sin(ang)*30*k) tgt=c
	elseif shot==2 then
		pos=Vector3.new(cA.X-4*k,2.5*k,(16-lt*1.2)*k) tgt=c+Vector3.new(0,3*k,0) fov=65
	elseif shot==3 then
		pos=Vector3.new(c.X-12*k+lt*4*k,5*k,-26*k) tgt=c
	elseif shot==4 then
		pos=cA+Vector3.new(-13*k,7*k,5*k) tgt=cB+Vector3.new(0,2*k,0) fov=55
	elseif shot==5 then
		pos=c+Vector3.new(math.sin(T*0.2)*10*k,(30-lt*2)*k,18*k) tgt=c
	else
		pos=c+Vector3.new(math.sin(T)*2*k,4*k,14*k) tgt=c+Vector3.new(0,3*k,0) fov=38
	end
	local sh=ST.shake
	local o=Vector3.new(math.random()-0.5,math.random()-0.5,math.random()-0.5)*sh*k*1.2
	cam.FieldOfView=fov
	cam.CFrame=CFrame.lookAt(pos+o,tgt+o)
	ST.shake=math.max(0,sh-dt*3)
end

