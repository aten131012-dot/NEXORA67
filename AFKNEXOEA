local function floatTo(pos,speed,abort)
	while HW.Active do
		local r=root()
		if not r then task.wait(0.3) continue end
		local d=pos-r.Position
		local m=d.Magnitude
		if m<3 then return true end
		local dt=RS.Heartbeat:Wait()
		r.CFrame=r.CFrame+d.Unit*math.min(speed*dt,m)
		r.AssemblyLinearVelocity=Vector3.zero
		if abort and abort() then return false end
	end
	return false
end

local function nameHas(o,l)
	local n=o:GetFullName():lower()
	for _,k in ipairs(l) do
		if n:find(k,1,true) then return true end
	end
	return false
end

local function scan()
	if tick()-(HW.lastScan or 0)<5 then return end
	HW.lastScan=tick()
	local old={}
	for _,h in ipairs(HW.Houses or {}) do old[h.door]=h end
	local out={}
	for _,d in ipairs(workspace:GetDescendants()) do
		if d:IsA("BasePart") and nameHas(d,CFG.Keywords) and not nameHas(d,CFG.Exclude)
			and (d.Name:lower():find("door") or d:FindFirstChildOfClass("TouchTransmitter")) then
			local h=old[d] or {door=d,last=-1e9}
			h.pos=d.Position
			table.insert(out,h)
		end
	end
	HW.Houses=out
end

local function nextReady()
	local r=root()
	local best,bd
	for _,h in ipairs(HW.Houses or {}) do
		if h.door.Parent and tick()-h.last>=CFG.KnockCooldown then
			local d=r and (h.pos-r.Position).Magnitude or 0
			if not bd or d<bd then best,bd=h,d end
		end
	end
	return best
end

local function standPos(h,from)
	local d=h.door
	local cf,sz=d.CFrame,d.Size
	local axis,thick
	if sz.X<sz.Z then axis=cf.RightVector thick=sz.X else axis=cf.LookVector thick=sz.Z end
	axis=Vector3.new(axis.X,0,axis.Z)
	if axis.Magnitude<0.1 then axis=Vector3.new(0,0,1) end
	axis=axis.Unit
	local toMe=Vector3.new(from.X-h.pos.X,0,from.Z-h.pos.Z)
	if toMe:Dot(axis)<0 then axis=-axis end
	local p=h.pos+axis*(thick/2+CFG.Gap)
	return Vector3.new(p.X,d.Position.Y-sz.Y/2+3,p.Z)
end

local function knock(h)
	local r=root()
	if not r then return end
	if not floatTo(standPos(h,r.Position),CFG.HouseSpeed) then return end
	h.last=tick()
	r=root()
	if not r then return end
	local cf0,tr0=h.door.CFrame,h.door.Transparency
	if firetouchinterest then
		pcall(function()
			firetouchinterest(r,h.door,0)
			task.wait(0.1)
			firetouchinterest(r,h.door,1)
		end)
	end
	local t0=tick()
	while HW.Active and tick()-t0<CFG.OpenTimeout do
		if h.door.CFrame~=cf0 or h.door.Transparency~=tr0 then break end
		task.wait(0.05)
	end
	r=root()
	if r then floatTo(r.Position-Vector3.new(0,CFG.SinkDown,0),80) end
	task.wait(CFG.AfterWait)
end

local function stagePoints()
	local pts={}
	local bs=workspace:FindFirstChild("BoatStages")
	local ns=bs and bs:FindFirstChild("NormalStages")
	if not ns then return pts end
	local arr={}
	for _,s in ipairs(ns:GetChildren()) do
		local n=tonumber(s.Name:match("%d+"))
		if n and s.Name:find("CaveStage") then table.insert(arr,{n,s}) end
	end
	table.sort(arr,function(a,b) return a[1]<b[1] end)
	for _,v in ipairs(arr) do
		local p=v[2]:FindFirstChild("DarknessPart") or v[2]:FindFirstChildWhichIsA("BasePart",true)
		if p then table.insert(pts,p.Position+Vector3.new(0,5,0)) end
	end
	local e=ns:FindFirstChild("TheEnd")
	local c2=e and e:FindFirstChild("GoldenChest")
	local tr=c2 and (c2:FindFirstChild("Trigger") or c2:FindFirstChildWhichIsA("BasePart",true))
	if tr then table.insert(pts,tr.Position) end
	return pts
end

local runId=0
local function main(id)
	local idx=1
	while HW.Active and runId==id do
		scan()
		local h=nextReady()
		if h then
			HW.Status="เคาะประตูบ้าน (พบ "..#HW.Houses.." หลัง)"
			knock(h)
		else
			local pts=stagePoints()
			if #pts==0 then
				HW.Status="รอคูลดาวน์... (ไม่เจอด่านให้ฟาร์ม)"
				task.wait(1)
			else
				if idx>#pts then idx=1 end
				HW.Status="ฟาร์มด่าน "..idx.."/"..#pts.." | บ้าน "..#(HW.Houses or {}).." หลัง"
				local done=floatTo(pts[idx],CFG.FarmSpeed,function()
					return runId~=id or nextReady()~=nil
				end)
				if done then
					idx+=1
					if idx>#pts then
						HW.Status="ถึงกล่องแล้ว รอเกิดใหม่..."
						task.wait(4)
						idx=1
					end
				end
			end
		end
		task.wait()
	end
end

HW.startMain=function()
	runId+=1
	HW.Status="เริ่มทำงาน..."
	task.spawn(main,runId)
end
HW.stopMain=function()
	runId+=1
	HW.Status="หยุดแล้ว"
end

