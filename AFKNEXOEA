			part(world,Vector3.new(w,h,w),cf,col,Enum.Material.Concrete)
			if win then
				part(world,Vector3.new(w+0.3,1.2,w+0.3),cf*CFrame.new(0,(math.random()-0.5)*h*0.8,0),sc.neon,nil,true)
			end
		end
	end
	if e.stars then
		for i=1,140 do
			local d=Vector3.new(math.random()-0.5,math.random()*0.8+0.05,math.random()-0.5).Unit*380
